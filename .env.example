# Supabase Configuration
# Note: Vite exposes environment variables to the browser only if they begin with "VITE_"
# Create a copy named ".env" and fill in your actual values when setting up Supabase.
# DO NOT put your real credentials in this .env.example file.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_project_key

# Vite requires the VITE_ prefix for variables used in the browser.
